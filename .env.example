# Example deployment .env (keys install.sh writes when creating .env).
# No real secrets. Copy to .env on the VPS; install.sh creates .env as 0600.

AWG_PORT=443
VPN_SUBNET=10.8.0.0/24
# Empty = public IP as the VPN client endpoint. Example: example.com
CLIENT_DOMAIN=

# install.sh sets AMNEZIA_SECURE_COOKIES=1 only in TLS panel mode
# (--panel-domain or --panel-port). Leave commented for loopback HTTP.
# AMNEZIA_SECURE_COOKIES=1
