# Environment / secrets
.env
.env.*
!.env.example

# Persistent application state
data/*
!data/.gitkeep

# Derived runtime state
config/*
!config/.gitkeep

status/*
!status/.gitkeep

# Encrypted backups
backups/*
!backups/.gitkeep

# Temporary files
tmp/
restore/
*.tmp

# Go build artifacts
/bin/
/dist/
*.test

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Logs
*.log
