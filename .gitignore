# Environment / secrets
.env
.env.*
!.env.example

# Persistent application state
data/*
!data/.gitkeep

# Derived runtime state
config/*
!config/.gitkeep

status/*
!status/.gitkeep

# Encrypted backups
backups/*
!backups/.gitkeep

# Temporary files
tmp/
restore/
*.tmp

# Go build artifacts
/bin/
/dist/
*.test
# local binary from `go build ./...` in app/panel (name = basename of module path)
/app/panel/amnezia-vpn-server

# Node toolchain (panel design system, T-120): the compiled
# internal/web/static/tailwind.css IS committed, dependencies are not.
node_modules/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Logs
*.log

# Milestone audit documents live only in AUDITS/ (never committed).
AUDITS/
# Internal design documents (spec, architecture, security notes) are
# kept out of the repository like the audits.
docs/
# The changelog is maintained locally and not committed.
CHANGELOG.md

# Beads / Dolt files (added by bd init). The whole .beads/ tree is
# local agent state (Dolt + JSONL export) and must stay untracked.
.dolt/
*.db
.beads-credential-key
.beads/
.beads/proxieddb/
*.gate.lock*

# Local agent / IDE / GitHub metadata: keep on disk for this machine,
# never commit. After untracking, GitHub Actions CI will not run — intended.
.agents/
.claude/
.codex/
.cursor/
# Local CI config stays local, with two deliberate exceptions: GitHub only
# runs what lives in the repository, and both of these have to run there.
# The release workflow, or there are no published images to pull — and the
# test workflow, because the harnesses have to run on Linux. A harness that
# only breaks where /bin/sh is dash stays green forever on a macOS laptop,
# which is exactly how one of them shipped broken.
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/release.yml
!.github/workflows/ci.yml
AGENTS.md
CLAUDE.md

# Git worktrees (local checkouts; never commit contents)
.worktrees/

.superpowers